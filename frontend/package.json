{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "vite dev",
		"build": "bun --bun run vite build",
		"build:ts": "bun --bun run vite build --mode typescript-server",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && oxlint . && eslint .",
		"test:lint": "node --test scripts/lint-config.test.mjs",
		"format": "prettier --write .",
		"test": "node node_modules/vitest/vitest.mjs run",
		"test:list": "node node_modules/vitest/vitest.mjs list"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-bun": "1.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-oxlint": "1.93.0",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.6.0",
		"happy-dom": "^20.14.5",
		"oxlint": "1.93.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@effect/experimental": "0.61.2",
		"@effect/platform": "0.97.3",
		"@effect/sql-sqlite-bun": "0.53.1",
		"effect": "3.22.4"
	}
}
