# Copy to .env for local development. Never put real secrets in this file.
# Replace BOTH placeholders with separate random values before starting.
# Generate each value: uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'

# Required: /admin password; also seeds the first Home room password.
APP_PASSWORD=replace-with-a-random-admin-password

# Required: NiceGUI session-storage signing key. Keep stable across restarts.
NICEGUI_STORAGE_SECRET=replace-with-a-separate-random-storage-secret

# Optional: defaults to list.db in the repository root.
# Use an absolute path for deployments; its parent directory must exist.
# DB_PATH=/absolute/path/to/list.db

# Local development: restart automatically when Python files change.
# Defaults to false when unset; leave unset or false on Railway.
APP_RELOAD=true

# Optional: defaults to 8080; --port overrides this value.
# PORT=8080
